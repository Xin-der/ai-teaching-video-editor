[
  {
    "rule_id": "DETECT_001",
    "name": "帧条件检测（预处理）",
    "description": "每一段视频帧先跑这个检测，判断有哪些可用信息，决定后续走哪个分支",
    "trigger": {"required": [], "optional": []},
    "always_run": true,
    "output": {
      "has_text_overlay": "boolean - 画面上是否有叠加的文字标签",
      "has_route_map_in_frame": "boolean - 画面上是否已有路线图元素",
      "has_valid_speech": "boolean - ASR 是否检测到有效人声",
      "location": "车内 | 车外道路 | 考场场地 | 驾校场地 | 其他",
      "activity": "讲解规则 | 讲解灯光 | 实操演示 | 路线介绍 | 起步操作 | 停车操作 | 转向操作 | 考试模拟 | 其他",
      "who_visible": ["教练", "学员", "无人物"],
      "visible_elements": ["仪表盘", "方向盘", "道路标线", "文字叠加", "路线图", "图示标注", "脚部特写", "其他"],
      "text_overlay_content": "画面上文字标签的具体内容，没有则为空字符串",
      "camera_angle": "车内前拍 | 车外前拍 | 侧面拍摄 | 正面拍摄 | 其他",
      "lighting": "白天 | 夜间 | 黄昏 | 室内"
    }
  },
  {
    "rule_id": "BRANCH_A",
    "name": "分支A: 有文字标签 → 精确红点定位",
    "priority": 1,
    "condition": {
      "description": "视频帧上有文字叠加标签，且提供了路线图素材",
      "required": ["has_text_overlay:true", "has_route_map_in_frame:true"],
      "optional": []
    },
    "actions": [
      {
        "op": "vlm_route_matching",
        "description": "VLM 读取帧上文字标签内容，对照路线图，输出红点在路线图上的位置坐标",
        "params": {
          "method": "text_to_map_position",
          "input": "text_overlay_content + route_map_image",
          "output": {"x": "0.0-1.0 比例坐标", "y": "0.0-1.0 比例坐标"}
        }
      },
      {
        "op": "animate_red_dot",
        "params": {
          "asset": "red_dot.png (8-12px 红色圆点)",
          "scale": 0.03,
          "path": "按 VLM 输出的坐标序列插值动画",
          "easing": "ease_in_out"
        }
      },
      {
        "op": "overlay_route_map",
        "params": {
          "position": "右上角",
          "scale": 0.35,
          "opacity": 0.9
        }
      }
    ]
  },
  {
    "rule_id": "BRANCH_B",
    "name": "分支B: 有语音无文字 → ASR关键词粗略定位",
    "priority": 2,
    "condition": {
      "description": "画面无文字标签，但 ASR 检测到有效人声，且有路线图",
      "required": ["has_valid_speech:true", "has_route_map_in_frame:true"],
      "required_absent": ["has_text_overlay:true"],
      "optional": []
    },
    "actions": [
      {
        "op": "asr_keyword_extraction",
        "description": "从 ASR 转写文本中提取位置关键词",
        "params": {
          "keywords": ["起步", "路口", "红绿灯", "转弯", "掉头", "变道", "超车", "停车", "终点", "斑马线", "公交站", "学校"],
          "output": "匹配到的关键词 + 时间戳"
        }
      },
      {
        "op": "vlm_route_matching",
        "description": "VLM 根据关键词在路线图上找对应位置",
        "params": {
          "method": "keyword_to_map_position",
          "input": "keywords + route_map_image",
          "output": {"x": "0.0-1.0", "y": "0.0-1.0"}
        }
      },
      {
        "op": "animate_red_dot",
        "params": {
          "asset": "red_dot.png",
          "scale": 0.03,
          "path": "按关键词匹配的坐标序列，段间匀速插值",
          "easing": "linear"
        }
      },
      {
        "op": "overlay_route_map",
        "params": {
          "position": "右上角",
          "scale": 0.35,
          "opacity": 0.9
        }
      }
    ]
  },
  {
    "rule_id": "BRANCH_C",
    "name": "分支C: 无文字无语音 → 纯视觉空间匹配",
    "priority": 3,
    "condition": {
      "description": "画面无文字标签且无有效人声，但有路线图",
      "required": ["has_route_map_in_frame:true"],
      "required_absent": ["has_text_overlay:true", "has_valid_speech:true"],
      "optional": []
    },
    "actions": [
      {
        "op": "vlm_spatial_matching",
        "description": "VLM 对比路面实景（道路形态、标线特征）与路线图几何结构，估计车辆位置",
        "params": {
          "method": "visual_to_map_matching",
          "input": "video_frame + route_map_image",
          "output": {"x": "0.0-1.0 估计坐标", "y": "0.0-1.0 估计坐标", "confidence": "low/medium"},
          "note": "精度有限，适用于大段匀速驾驶场景"
        }
      },
      {
        "op": "animate_red_dot",
        "params": {
          "asset": "red_dot.png",
          "scale": 0.03,
          "path": "按估计坐标，整段匀速移动",
          "easing": "linear",
          "note": "段内匀速，段间不做插值，避免路径跳跃"
        }
      },
      {
        "op": "overlay_route_map",
        "params": {
          "position": "右上角",
          "scale": 0.35,
          "opacity": 0.9
        }
      }
    ]
  },
  {
    "rule_id": "BRANCH_D",
    "name": "分支D: 无路线图 → 通用风格规则",
    "priority": 4,
    "condition": {
      "description": "当前视频没有提供路线图素材（input/ 下无 route_map.png）",
      "required_absent": ["has_route_map_in_frame:true"]
    },
    "actions": [
      {
        "op": "skip_route_overlay",
        "description": "不叠加路线图，不做红点动画。通用规则（zoom、PiP、字幕）由匹配引擎自动触发。"
      }
    ]
  },
  {
    "rule_id": "RULE_ZOOM",
    "name": "通用: 实操段缓慢推进缩放",
    "trigger": {
      "required": ["activity:实操演示"],
      "optional": ["location:车外道路"]
    },
    "actions": [
      {
        "op": "zoom_keyframe",
        "params": {
          "scale_start": 1.0,
          "scale_end": 1.12,
          "duration_per_segment": "与段时长一致",
          "easing": "ease_out"
        },
        "description": "实操行驶段缓慢 zoom in，增强临场感。无工程参数时默认 1.0→1.12"
      }
    ]
  },
  {
    "rule_id": "RULE_PIP",
    "name": "通用: 关键操作画中画特写",
    "trigger": {
      "any_of": ["activity:起步操作", "activity:停车操作", "activity:讲解灯光"],
      "optional": ["who:学员"]
    },
    "actions": [
      {
        "op": "add_pip_if_available",
        "params": {
          "foot_closeup": {"position": "左下角", "scale": 0.25, "source": "input/foot_closeup.mp4 或 input/foot_closeup.jpg"},
          "dashboard_closeup": {"position": "左上角", "scale": 0.25, "source": "input/dashboard_closeup.mp4 或 input/dashboard_closeup.jpg"},
          "route_map": {"position": "右上角", "scale": 0.35, "source": "input/route_map.png"},
          "rule": "特写素材放在左上角，路线图放在右上角，两者不重叠"
        },
        "description": "如果 input/ 下存在对应素材则叠加，不存在则跳过。路线图占据右上角，特写放左上角，避免遮挡"
      }
    ]
  },
  {
    "rule_id": "RULE_TEXT_OVERLAY",
    "name": "通用: 教学字幕烧录",
    "trigger": {
      "required": ["has_valid_speech:true"],
      "optional": ["activity:讲解规则", "activity:讲解灯光", "activity:路线介绍"]
    },
    "actions": [
      {
        "op": "burn_subtitles",
        "params": {
          "source": "ASR 转写文本",
          "position": "底部居中",
          "font": "思源黑体 Bold",
          "font_size": 32,
          "color": "#FFFFFF",
          "stroke_width": 8,
          "stroke_color": "#000000",
          "max_chars_per_line": 20
        },
        "description": "将 ASR 转写文本烧录为字幕，底部居中，白色字体黑色描边"
      }
    ]
  },
  {
    "rule_id": "RULE_ROUTE_MAP_PREP",
    "name": "路线图素材预处理",
    "trigger": {
      "required": ["has_route_map_in_frame:true"]
    },
    "actions": [
      {
        "op": "chroma_key_blue",
        "params": {
          "input": "原始路线图",
          "color": "蓝色",
          "threshold": 0.1,
          "output": "透明背景的路线图，仅保留路径线条"
        },
        "description": "对路线图做蓝色色度抠图，去除背景，只保留蓝色路线路径和标题文字。如果用户提供的素材已经处理过则跳过此步"
      }
    ]
  }
]
