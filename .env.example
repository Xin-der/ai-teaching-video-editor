# 多平台智能切片工具 — 环境配置
# 复制此文件为 .env 并填入你的 API Key

# ========================================
# 阿里云 DashScope (通义千问 VL)
# ========================================
# 注册地址: https://dashscope.aliyun.com/
# 开通"模型服务灵积"后获取 API Key
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 模型选择 (qwen-vl-plus 免费额度够用, qwen-vl-max 效果更好)
MODEL=qwen3.7-plus

# ========================================
# ffmpeg 路径（可选，如果在 PATH 中则不需要）
# ========================================
# 如果 ffmpeg 不在系统 PATH 中，取消下面的注释并填入完整路径
# FFMPEG=D:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE=D:/tools/ffmpeg/bin/ffprobe.exe

# ========================================
# 说明
# ========================================
# 1. 必须配置: DASHSCOPE_API_KEY（用于 VLM 场景描述）
# 2. 推荐安装: ffmpeg（用于视频导出，建议加入 PATH）
# 3. 可选安装: CUDA torch（加速 FunASR 语音识别）
