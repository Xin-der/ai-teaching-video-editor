{
  "platform": "douyin",
  "name": "抖音竖屏模板",
  "version": "1.0",
  "description": "9:16竖屏 + 大字幕 + 关键词弹窗 + 进度条 + BGM",

  "video": {
    "output_resolution": [1080, 1920],
    "aspect_ratio": "9:16",
    "fps": 30,
    "codec": "libx264",
    "bitrate": "8M",
    "audio_codec": "aac",
    "audio_bitrate": "256k"
  },

  "layout": {
    "title_card": {
      "enabled": true,
      "duration_seconds": 2.0,
      "position": "top",
      "font_size_ratio": 0.06,
      "font": "SimHei",
      "color": "#FFFFFF",
      "stroke_color": "#000000",
      "stroke_width": 3,
      "bg_color": "rgba(0,0,0,0.5)",
      "bg_height_ratio": 0.12,
      "animation": "fade_in"
    },
    "video_area": {
      "source_crop": "center",
      "position_y_ratio": 0.0,
      "height_ratio": 1.0
    },
    "subtitle": {
      "enabled": true,
      "font_size_ratio": 0.038,
      "font": "SimHei",
      "color": "#FFFFFF",
      "stroke_color": "#000000",
      "stroke_width": 6,
      "position_y_ratio": 0.82,
      "bg_color": "rgba(0,0,0,0.5)",
      "max_chars_per_line": 12,
      "max_lines": 2,
      "word_by_word": false
    },
    "keyword_popup": {
      "enabled": true,
      "duration_seconds": 1.5,
      "font_size_ratio": 0.05,
      "font": "SimHei",
      "color": "#FFD700",
      "stroke_color": "#CC0000",
      "stroke_width": 3,
      "bg_color": "rgba(255,0,0,0.8)",
      "position_y_ratio": 0.50,
      "trigger_keywords": ["记住", "重点", "千万别", "一定", "必须", "注意", "小心", "关键", "容易错", "挂科"]
    },
    "progress_bar": {
      "enabled": true,
      "height_px": 6,
      "color": "#FF4444",
      "bg_color": "rgba(255,255,255,0.3)",
      "position": "bottom"
    },
    "ending_card": {
      "enabled": true,
      "duration_seconds": 3.0,
      "text": "你觉得最难的是哪项？评论区告诉我！",
      "font_size_ratio": 0.04,
      "color": "#FFFFFF",
      "bg_color": "rgba(0,0,0,0.7)"
    }
  },

  "audio": {
    "bgm": {
      "enabled": true,
      "volume_ratio": 0.45,
      "loop": true
    },
    "silence_speedup": {
      "enabled": true,
      "speed_factor": 1.3,
      "silence_threshold_db": -40,
      "min_silence_duration": 1.0
    }
  },

  "copy_config": {
    "include_title": true,
    "include_hashtags": true,
    "include_bullet_comments": false,
    "max_title_length": 50,
    "engagement_style": "question"
  }
}
