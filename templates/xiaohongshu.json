{
  "platform": "xiaohongshu",
  "name": "小红书1:1模板",
  "version": "1.0",
  "description": "1:1方形 + 要点列表覆盖 + 封面图生成",

  "video": {
    "output_resolution": [1080, 1080],
    "aspect_ratio": "1:1",
    "fps": 30,
    "codec": "libx264",
    "bitrate": "6M",
    "audio_codec": "aac",
    "audio_bitrate": "256k"
  },

  "layout": {
    "title_card": {
      "enabled": false
    },
    "video_area": {
      "source_crop": "center",
      "position_y_ratio": 0.0,
      "height_ratio": 1.0
    },
    "subtitle": {
      "enabled": true,
      "font_size_ratio": 0.035,
      "font": "SimHei",
      "color": "#FFFFFF",
      "stroke_color": "#000000",
      "stroke_width": 3,
      "position_y_ratio": 0.88,
      "bg_color": "rgba(0,0,0,0.35)",
      "max_chars_per_line": 20,
      "max_lines": 2,
      "word_by_word": false
    },
    "key_points_overlay": {
      "enabled": true,
      "position": "right",
      "width_ratio": 0.38,
      "margin_right_ratio": 0.02,
      "margin_top_ratio": 0.06,
      "font_size_ratio": 0.024,
      "font": "SimHei",
      "color": "#FFD700",
      "stroke_color": "#000000",
      "stroke_width": 2,
      "bg_color": "rgba(0,0,0,0.6)",
      "corner_radius": 10,
      "item_prefix": "📌",
      "line_spacing": 1.6,
      "max_items": 3
    },
    "cover_image": {
      "enabled": true,
      "generate_at": "first_frame",
      "cover_text_font_size_ratio": 0.06,
      "cover_text_color": "#FFFFFF",
      "cover_text_stroke": "#000000",
      "cover_text_stroke_width": 3,
      "cover_bg_overlay": "rgba(0,0,0,0.3)",
      "output_path": "cover.jpg"
    },
    "ending_card": {
      "enabled": true,
      "duration_seconds": 3.0,
      "text": "收藏起来，考前看一遍！",
      "font_size_ratio": 0.035,
      "color": "#FFFFFF",
      "bg_color": "rgba(0,0,0,0.7)"
    }
  },

  "audio": {
    "bgm": {
      "enabled": true,
      "volume_ratio": 0.40,
      "loop": true
    },
    "silence_speedup": {
      "enabled": true,
      "speed_factor": 1.2,
      "silence_threshold_db": -40,
      "min_silence_duration": 1.5
    },
    "original_audio": {
      "volume_ratio": 0.9
    }
  },

  "copy_config": {
    "include_title": true,
    "include_hashtags": true,
    "include_bullet_comments": false,
    "max_title_length": 30,
    "note_style": "bullet_points",
    "cover_style": "text_overlay"
  }
}
